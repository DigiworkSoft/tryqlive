# ===========================================
# TRYQ Masterclass Pune - Environment Variables
# ===========================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# All VITE_ prefixed variables are exposed to the browser.
# Do NOT put truly secret keys here — this is a client-side app.

# --- Event Configuration ---
# The date/time of the live webinar (ISO 8601 format with timezone)
VITE_EVENT_DATE="2026-05-10T11:00:00+05:30"

# --- Links ---
# Live webinar join URL (Zoom/Google Meet/etc.)
VITE_LIVE_URL="https://meet.google.com/abc-defg-hij"

# WhatsApp community invite link
VITE_WHATSAPP_URL="https://chat.whatsapp.com/your-community-link"

# Mentor's portfolio/about page URL
VITE_MENTOR_URL="https://sk-cyan.vercel.app/"

# --- Google Sheets Integration ---
# Google Apps Script Web App URL for form data storage
VITE_GOOGLE_SCRIPT_URL="https://script.google.com/macros/s/YOUR_SCRIPT_ID/exec"
